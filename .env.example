# URL publique du site (canoniques, sitemap)
SITE_URL=https://www.hotel-meyrueis-lozere.fr

# Envoi des demandes du formulaire par e-mail (SMTP).
# Si SMTP_HOST est vide, le formulaire fonctionne en MODE DÉMONSTRATION :
# la demande est validée mais n'est transmise à personne, et le visiteur en est informé.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Site Grand Hôtel de France <no-reply@example.fr>"
MAIL_TO=grandhoteldefrance@wanadoo.fr

# Nombre maximal d'envois du formulaire par adresse IP et par tranche de 10 minutes (défaut : 5).
CONTACT_RATE_LIMIT=5
