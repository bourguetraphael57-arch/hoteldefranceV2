---
/** Affichage d'un prix indicatif. Sans prix : texte explicite, jamais « -€ ». */
import { formatEuros } from '../lib/format';
interface Props { prix?: number; unite?: string; base?: string; indicatif?: boolean; vide?: string }
const { prix, unite, base, vide = 'Tarif sur demande' } = Astro.props;
---
{prix !== undefined ? (
  <p class="price">
    {formatEuros(prix)}{unite && <small> {unite}</small>}
    {base && <small class="price__base"><br />{base}</small>}
  </p>
) : (
  <p class="price-unknown">{vide}</p>
)}
