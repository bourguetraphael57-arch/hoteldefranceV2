---
/**
 * Rose des vents / boussole des Causses au trait (carnet d'exploration).
 * Tracé au trait animé, aiguille oscillant doucement vers le Nord.
 */
interface Props {
  class?: string;
  taille?: 'sm' | 'md' | 'lg';
}
const { class: className, taille = 'md' } = Astro.props;
---
<div class:list={['m-boussole', `m-boussole--${taille}`, className]} data-motion="time" aria-hidden="true">
  <svg viewBox="0 0 84 84" focusable="false" aria-hidden="true">
    <!-- Cadran circulaire extérieur -->
    <circle class="m-draw m-boussole__ring" pathLength="1" cx="42" cy="42" r="38" style="--d: 0s" />
    <circle class="m-draw m-boussole__ring-inner" pathLength="1" cx="42" cy="42" r="32" style="--d: 0.2s" />
    <!-- Graduations cardinales et intercardinales -->
    <path class="m-draw" pathLength="1" d="M42 4 V10 M42 74 V80 M4 42 H10 M74 42 H80" style="--d: 0.3s" />
    <path class="m-draw m-boussole__ticks" pathLength="1" d="M15 15 L19 19 M65 65 L69 69 M15 69 L19 65 M65 19 L69 15" style="--d: 0.4s" />
    <!-- Étoile à 8 branches -->
    <path class="m-draw m-boussole__star" pathLength="1" d="M42 12 L45 39 L72 42 L45 45 L42 72 L39 45 L12 42 L39 39 Z" style="--d: 0.5s" />
    <!-- Points cardinaux -->
    <text x="42" y="9" class="m-boussole__cardinal" text-anchor="middle">N</text>
    <text x="42" y="82" class="m-boussole__cardinal" text-anchor="middle">S</text>
    <text x="81" y="45" class="m-boussole__cardinal" text-anchor="middle">E</text>
    <text x="3" y="45" class="m-boussole__cardinal" text-anchor="middle">O</text>
    <!-- Aiguille de la boussole -->
    <g class="m-boussole__needle">
      <path class="m-boussole__needle-n" d="M42 42 L39 42 L42 16 L45 42 Z" />
      <path class="m-boussole__needle-s" d="M42 42 L39 42 L42 68 L45 42 Z" />
      <circle cx="42" cy="42" r="3" class="m-boussole__pivot" />
    </g>
  </svg>
</div>
