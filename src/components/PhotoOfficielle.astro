---
import { creditOfficiel, type PhotoOfficielle } from '../data/photos-officielles';

interface Props {
  photo: PhotoOfficielle;
  class?: string;
  /** Afficher le crédit sous l'image (masqué dans les cartes, rappelé en page chambre). */
  legende?: boolean;
  eager?: boolean;
  sizes?: string;
}
const { photo: p, class: cls, legende = true, eager = false, sizes = '(min-width: 64rem) 40rem, 100vw' } = Astro.props;
---
<figure class:list={['photo-officielle', cls]}>
  <picture>
    <source type="image/webp" srcset={`${p.src}-800.webp 800w, ${p.src}-1600.webp 1600w`} sizes={sizes} />
    <img
      src={`${p.src}-800.jpg`}
      srcset={`${p.src}-800.jpg 800w, ${p.src}-1600.jpg 1600w`}
      sizes={sizes}
      alt={p.alt}
      width={p.largeur}
      height={p.hauteur}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </picture>
  {legende && (
    <figcaption class="credit">
      {p.remarque && <span class="photo-officielle__remarque">{p.remarque} </span>}
      <span>{creditOfficiel}</span>
    </figcaption>
  )}
</figure>
