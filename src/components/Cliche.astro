---
/**
 * Photo de composition (libre ou officielle), avec recadrage et légende.
 * - Photo libre : crédit auteur + licence + source toujours affiché (CC BY / BY-SA).
 * - Photo officielle : « © Grand Hôtel de France » (+ remarque éventuelle de la donnée).
 * caption : « complet » (légende + crédit, défaut), « credit » (crédit seul),
 *   « legende » (légende seule) ou « aucune » : le crédit DOIT alors figurer dans un <CreditsGroupe> de la même page.
 * overlay : légende posée sur l'image, sur un bandeau sombre (contraste AA). La remarque éventuelle
 *   d'une photo officielle n'y figure pas : elle est reprise par <CreditsGroupe>.
 */
import { resoudre, type Visuel } from '../data/visuels';

interface Props {
  visuel: Visuel;
  sizes: string;
  eager?: boolean;
  caption?: 'complet' | 'legende' | 'credit' | 'aucune';
  overlay?: boolean;
  class?: string;
  alt?: string;
}
const { visuel, sizes, eager = false, caption = 'complet', overlay = false, class: className, alt } = Astro.props;
const p = resoudre(visuel.photo);
const h800 = Math.round((p.hauteur * 800) / p.largeur);
const legende = overlay || caption === 'credit' || caption === 'aucune' ? undefined : visuel.legende;
/** La remarque d'une photo officielle reste visible hors mode overlay. */
const remarque = caption === 'aucune' || overlay ? undefined : p.remarque;
---
<figure class:list={['cliche', { 'cliche--overlay': overlay }, className]} style={visuel.position ? `--pos: ${visuel.position}` : undefined}>
  <picture>
    <source type="image/webp" srcset={`${p.src}-800.webp 800w, ${p.src}-1600.webp ${p.largeur}w`} sizes={sizes} />
    <img
      src={`${p.src}-800.jpg`}
      srcset={`${p.src}-800.jpg 800w, ${p.src}-1600.jpg ${p.largeur}w`}
      sizes={sizes}
      width="800"
      height={h800}
      alt={alt ?? p.alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'sync' : 'async'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
  </picture>
  {(legende || remarque) && <figcaption class="cliche__caption">
    {legende && <span class="cliche__legende">{legende}</span>}
    {remarque && <span class="cliche__remarque">{remarque}</span>}
  </figcaption>}
</figure>
