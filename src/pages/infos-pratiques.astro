---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageHero from '../components/PageHero.astro';
import AccessibilityNotice from '../components/AccessibilityNotice.astro';
import Cliche from '../components/Cliche.astro';
import PhotoPending from '../components/PhotoPending.astro';
import Itineraire from '../components/motion/Itineraire.astro';
import Boussole from '../components/motion/Boussole.astro';
import Divider from '../components/motion/Divider.astro';
import { itineraireAcces } from '../data/motion';
import { heros, infosVisuels, estAttendu, type Visuel, type Attendu } from '../data/visuels';

const equipements: (Visuel | Attendu)[] = [...infosVisuels.equipements];
const equipementsPhotos = equipements.filter((v): v is Visuel => !estAttendu(v));
const equipementsAttendus = equipements.filter(estAttendu);
import { hotel } from '../data/hotel';
import { seo } from '../data/seo';
---
<BaseLayout title={seo.infos.title} description={seo.infos.description}>
  <Breadcrumbs items={[{ href: '/infos-pratiques/', label: 'Infos pratiques' }]} />
  <PageHero
    photo={heros.infos}
    title="Infos pratiques et accessibilité"
    lead="Horaires, accès, stationnement, équipements : l’essentiel pour préparer votre séjour. Si vous avez des besoins particuliers, lisez la rubrique accessibilité et appelez l’hôtel avant de réserver."
  >
    <nav aria-label="Sur cette page" class="mt-5">
      <ul class="anchor-nav">
        <li><a href="#horaires">Horaires</a></li>
        <li><a href="#acces">Accès</a></li>
        <li><a href="#equipements">Équipements</a></li>
        <li><a href="#accessibilite">Accessibilité</a></li>
      </ul>
    </nav>
  </PageHero>

  <section class="section section--tight" aria-labelledby="horaires">
    <div class="container">
      <h2 id="horaires">Horaires</h2>
      <dl class="facts facts--lg mt-5">
        <dt>Arrivées</dt><dd>{hotel.horaires.arrivee}</dd>
        <dt>Départs</dt><dd>{hotel.horaires.depart}</dd>
        <dt>Petit-déjeuner</dt><dd>{hotel.horaires.petitDejeuner}</dd>
        <dt>Restaurant</dt><dd>Dîner de 19 h à 21 h — <a href="/restaurant/#titre-horaires">horaires détaillés</a></dd>
      </dl>
      <p class="mt-4 muted">Vous arrivez après 20 h ? Prévenez l’hôtel.</p>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="acces">
    <div class="container split">
      <div class="stack">
        <h2 id="acces">Venir à l’hôtel</h2>
        <address><strong>{hotel.nom}</strong><br />{hotel.adresse.rue}<br />{hotel.adresse.codePostal} {hotel.adresse.ville}</address>
        <h3 class="h4">En voiture</h3>
        <p>{hotel.acces.voiture}</p>
        <h3 class="h4">En train</h3>
        <p>{hotel.acces.train}</p>
        <h3 class="h4">En avion</h3>
        <p>{hotel.acces.avion}</p>
        <h3 class="h4">Stationnement</h3>
        <p>Parking privé sécurisé à l’hôtel et garage pour les motos et les vélos.</p>
        <p><a class="btn btn--secondary" href={hotel.itineraire} rel="noopener">Calculer l’itinéraire<span class="sr-only"> (Google Maps, site externe)</span></a></p>
      </div>
      <div class="stack">
        <div class="inline-flex">
          <Boussole taille="sm" />
          <h3 class="h4" style="margin: 0;">À proximité</h3>
        </div>
        <Itineraire etapes={itineraireAcces.etapes} label={itineraireAcces.label} />
        <Cliche visuel={infosVisuels.acces} class="bleed" sizes="(min-width: 72rem) 32rem, (min-width: 56rem) 45vw, 100vw" />
      </div>
    </div>
  </section>

  <Divider variant="riviere" />

  <section class="section" aria-labelledby="equipements">
    <div class="container">
      <h2 id="equipements">Équipements et services</h2>
      <ul class="vignettes vignettes--duo mt-5" aria-label={infosVisuels.equipementsLabel}>
        {equipementsPhotos.map((v) => <li><Cliche visuel={v} sizes="(min-width: 72rem) 46rem, (min-width: 48rem) 64vw, 100vw" /></li>)}
        {equipementsAttendus.length > 0 && (
          <li><figure class="cliche"><PhotoPending label={equipementsAttendus.map((v) => v.attendu.toLowerCase()).join(', ')} ratio="3 / 2" /><figcaption class="cliche__caption"><span class="cliche__legende">{equipementsAttendus.map((v) => v.legende).join(' · ')}</span></figcaption></figure></li>
        )}
      </ul>
      <div class="table-wrap mt-6" role="region" aria-labelledby="caption-equipements" tabindex="0">
        <table class="table">
          <caption id="caption-equipements">Équipements de l’hôtel</caption>
          <thead><tr><th scope="col">Équipement</th><th scope="col">Précision</th></tr></thead>
          <tbody>
            {hotel.equipements.map((e) => (
              <tr><th scope="row">{e.label}</th><td>{'detail' in e ? e.detail : '—'}</td></tr>
            ))}
            <tr><th scope="row">Animaux</th><td>{hotel.animaux.texte}</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="accessibilite-titre">
    <div class="container--narrow">
      <AccessibilityNotice full />
      <p class="mt-5"><a href="/faq/#accessibilite">Questions fréquentes sur l’accessibilité</a></p>
    </div>
  </section>
</BaseLayout>
