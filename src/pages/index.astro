---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingBlock from '../components/BookingBlock.astro';
import RoomCard from '../components/RoomCard.astro';
import OfferCard from '../components/OfferCard.astro';
import Photo from '../components/Photo.astro';
import Cliche from '../components/Cliche.astro';
import AccessibilityNotice from '../components/AccessibilityNotice.astro';
import Icon from '../components/Icon.astro';
import Vautour from '../components/Vautour.astro';
import Divider from '../components/motion/Divider.astro';
import Annotation from '../components/motion/Annotation.astro';
import TamponVoyage from '../components/motion/TamponVoyage.astro';
import Itineraire from '../components/motion/Itineraire.astro';
import { annotations, itineraireAcces } from '../data/motion';
import { hotel } from '../data/hotel';
import { chambres } from '../data/chambres';
import { getOffre } from '../data/offres';
import { restaurant } from '../data/restaurant';
import { sitesAccueil } from '../data/environs';
import { seo } from '../data/seo';
import { accueil, offresPhotos } from '../data/visuels';

const formules = ['demi-pension', 'petit-dejeuner', 'demi-pension-groupe'].map((s) => getOffre(s)!);
/** Vignette réelle seulement si elle existe (sinon carte sans image, jamais une fausse photo). */
const photoFormule = (slug: string) => offresPhotos[slug];
---
<BaseLayout title={seo.accueil.title} description={seo.accueil.description}>
  <!-- HERO PRINCIPAL -->
  <section class="hero" aria-labelledby="titre-page">
    <Photo id="meyrueis-pont" eager credit={false} class="hero__bg" sizes="100vw" />
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="hero__sky" aria-hidden="true">
      <Vautour class="hero__bird hero__bird--1" />
      <Vautour class="hero__bird hero__bird--2" />
      <Vautour class="hero__bird hero__bird--3" />
    </div>
    <div class="container hero__content">
      <div class="stack hero__text">
        <p class="title-script hero__accent">Bienvenue au</p>
        <h1 id="titre-page" class="hero__title">
          {hotel.nom} <span class="hero__stars-inline" aria-label="Hôtel 3 étoiles">★★★</span>
        </h1>
        <p class="hero__tagline">Votre maison d’hôtes et de terroir au cœur des Gorges de la Jonte et du Parc national des Cévennes</p>
        <p class="lead">
          Sur la place du village de Meyrueis, la famille {hotel.histoire.famille} perpétue depuis {hotel.histoire.depuis} l’hospitalité chaleureuse d’un ancien relais de poste du XVIIᵉ siècle.
        </p>
        <div class="btn-row mt-5">
          <a class="btn btn--primary" href="#reserver">Réserver mon séjour</a>
          <a class="btn btn--secondary" href="/chambres/">Découvrir les chambres</a>
        </div>
        <ul class="atouts mt-5">
          <li><Icon name="bed" />{hotel.nombreChambres} chambres calmes</li>
          <li><Icon name="fork" />Restaurant du terroir</li>
          <li><Icon name="pool" />Piscine chauffée &amp; jardin</li>
          <li><Icon name="parking" />Parking privé &amp; garage sécurisé</li>
        </ul>
      </div>
    </div>

    <!-- Relief des causses qui se dessine, puis la Jonte qui coule vers la section suivante. -->
    <svg class="hero__relief" viewBox="0 0 1440 200" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <path class="hero__relief-back" d="M0 110 L90 108 L130 80 L300 76 L340 100 L420 98 L470 62 L700 58 L740 92 L820 95 L880 70 L1080 66 L1120 96 L1200 94 L1250 72 L1440 70 V200 H0 Z" />
      <path class="hero__relief-line" pathLength="1" vector-effect="non-scaling-stroke" d="M0 110 L90 108 L130 80 L300 76 L340 100 L420 98 L470 62 L700 58 L740 92 L820 95 L880 70 L1080 66 L1120 96 L1200 94 L1250 72 L1440 70" />
      <path class="hero__relief-front" d="M0 160 C180 140 300 175 480 150 S800 120 1000 150 S1300 170 1440 140 V200 H0 Z" />
      <path class="hero__river" vector-effect="non-scaling-stroke" d="M0 182 C200 170 360 192 560 180 S900 166 1100 182 S1340 188 1440 176" />
    </svg>
    <a href="#reserver" class="hero__scroll" aria-label="Faire défiler vers le contenu">
      <span class="hero__scroll-mouse">
        <span class="hero__scroll-wheel"></span>
      </span>
      <span class="hero__scroll-text">Découvrir</span>
    </a>
  </section>

  <!-- BARRE DE RÉSERVATION OVERLAY -->
  <div class="hero-booking-wrap" id="reserver">
    <div class="container">
      <BookingBlock wide titre="Réserver en direct au meilleur tarif" />
    </div>
  </div>

  <!-- BARRE DE CONFIANCE -->
  <div class="trust-bar">
    <div class="container trust-bar__inner">
      <div class="trust-item">
        <span class="trust-item__stars">★★★</span>
        <strong>Hôtel 3 étoiles de charme</strong>
        <span>Classement officiel en Lozère</span>
      </div>
      <div class="trust-divider" aria-hidden="true"></div>
      <div class="trust-item">
        <span class="trust-item__score"><strong>4.7</strong> / 5</span>
        <strong>Avis voyageurs certifiés</strong>
        <span>Recommandé sur Google &amp; TripAdvisor</span>
      </div>
      <div class="trust-divider" aria-hidden="true"></div>
      <div class="trust-item">
        <span class="trust-item__stars" style="letter-spacing: normal;"><Icon name="bed" /></span>
        <strong>Maison familiale depuis {hotel.histoire.depuis}</strong>
        <span>Trois générations d’hospitalité</span>
      </div>
    </div>
  </div>

  <!-- SECTION 2 : WELCOME / LA MAISON (AVEC COMPTEURS ANIMÉS) -->
  <section class="section section--surface maison-section" aria-labelledby="titre-maison">
    <div class="container maison">
      <div class="stack">
        <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
          <p class="title-script" style="margin: 0; font-size: clamp(1.75rem, 3.5vw, 2.3rem);">{accueil.maison.surtitre}</p>
          <TamponVoyage />
        </div>
        <h2 id="titre-maison">{accueil.maison.titre}</h2>
        <p>
          Au cœur de Meyrueis, le Grand Hôtel de France cultive <strong>un art de recevoir sincère et chaleureux</strong>, transmis de génération en génération au sein de la même famille depuis {hotel.histoire.depuis}.
        </p>
        <p>
          Ancien relais de poste du XVIIᵉ siècle bâti sur la place du village, notre maison vous accueille comme dans <strong>une grande demeure de famille</strong>, où le charme des vieilles pierres côtoie la fraîcheur de la rivière et la sérénité des causses lozériens.
        </p>
        <p>
          Après vos escapades dans les gorges de la Jonte et du Tarn, retrouvez <strong>la douceur de notre piscine chauffée</strong>, l’ombre bienfaisante du jardin et la générosité d’une table attachée au terroir lozérien.
        </p>
        <div class="counters-grid mt-6" aria-label="L'hôtel en chiffres clés">
          <div class="counter-card">
            <span class="counter-number"><span data-counter="44">44</span></span>
            <span class="counter-label">Chambres calmes</span>
            <span class="counter-sub">De 2 à 4 personnes avec ascenseur</span>
          </div>
          <div class="counter-card">
            <span class="counter-number"><span data-counter="4.7">4.7</span> <small>/ 5</small></span>
            <span class="counter-label">Note voyageurs certifiée</span>
            <span class="counter-sub">Plus de 380 avis Google &amp; TripAdvisor</span>
          </div>
          <div class="counter-card">
            <span class="counter-number"><span data-counter="15">15</span> <small>min</small></span>
            <span class="counter-label">Des Gorges &amp; Grands Causses</span>
            <span class="counter-sub">Aven Armand, Jonte &amp; Cévennes</span>
          </div>
        </div>
      </div>
      <div class="maison__photos">
        <Cliche visuel={accueil.maison.principale} class="maison__principale" caption="legende" sizes="(min-width: 72rem) 34rem, (min-width: 56rem) 48vw, 88vw" />
        <Cliche visuel={accueil.maison.secondaire} class="maison__secondaire" caption="aucune" sizes="(min-width: 56rem) 18rem, 46vw" />
        <Annotation vers="haut-droite">{annotations.maison}</Annotation>
      </div>
    </div>
  </section>

  <!-- SECTION 3 : LES CHAMBRES -->
  <section class="section section--alt" aria-labelledby="titre-chambres">
    <div class="container">
      <div class="section__head">
        <p class="title-script" style="margin-bottom: 0.25rem;">Nos chambres &amp; suites</p>
        <h2 id="titre-chambres">Un cocon de repos entre Causses et Cévennes</h2>
        <p>Quatre catégories pensées pour votre confort, de 2 à 4 personnes, avec wifi gratuit, literie soignée et ascenseur. Réservez en direct au meilleur tarif garanti.</p>
      </div>
      <div class="grid grid--4 rail">
        {chambres.map((c) => <RoomCard chambre={c} />)}
      </div>
      <p class="mt-5"><a href="/chambres/#comparatif">Voir le tableau comparatif complet des chambres</a></p>
    </div>
  </section>

  <!-- SECTION SERVICES & ATTENTIONS -->
  <section class="section" aria-labelledby="titre-services">
    <div class="container">
      <div class="section__head">
        <p class="title-script" style="margin-bottom: 0.25rem;">Tout pour votre confort</p>
        <h2 id="titre-services">Les services &amp; attentions de la maison</h2>
        <p>Un ensemble de prestations pensées pour faire de votre séjour en Lozère une parenthèse sereine et ressourçante.</p>
      </div>
      <div class="services-grid mt-6">
        <div class="service-item">
          <div class="service-icon"><Icon name="pool" /></div>
          <h3>Piscine chauffée &amp; jardin</h3>
          <p>Bassin chauffé extérieur ouvert en saison avec transats, entouré de verdure et face aux falaises des causses.</p>
        </div>
        <div class="service-item">
          <div class="service-icon"><Icon name="parking" /></div>
          <h3>Parking privé &amp; garage fermé</h3>
          <p>Stationnement réservé à la clientèle, garage fermé dédié aux motos et abri sécurisé pour vélos.</p>
        </div>
        <div class="service-item">
          <div class="service-icon"><Icon name="fork" /></div>
          <h3>Restaurant de terroir</h3>
          <p>Cuisine maison valorisant les producteurs lozériens, servie dans la salle voûtée historique ou en terrasse.</p>
        </div>
        <div class="service-item">
          <div class="service-icon"><Icon name="coffee" /></div>
          <h3>Petit-déjeuner gourmand</h3>
          <p>Buffet généreux servi chaque matin : confitures artisanales, viennoiseries, charcuteries et fromages locaux.</p>
        </div>
        <div class="service-item">
          <div class="service-icon"><Icon name="wifi" /></div>
          <h3>Wi-Fi haut débit fibré</h3>
          <p>Connexion rapide et gratuite dans l’ensemble des chambres, des salons et des espaces extérieurs.</p>
        </div>
        <div class="service-item">
          <div class="service-icon"><Icon name="shield" /></div>
          <h3>Ascenseur &amp; tranquillité</h3>
          <p>Accès facile à tous les étages, chambres calmes, salon de détente et conseils avisés pour vos itinéraires.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION RESTAURANT -->
  <section class="section section--alt" aria-labelledby="titre-restaurant">
    <div class="container split">
      <div class="duo">
        <Cliche visuel={accueil.restaurant.principale} class="duo__principale" overlay sizes="(min-width: 72rem) 38rem, (min-width: 56rem) 52vw, 100vw" />
        <Cliche visuel={accueil.restaurant.vignette} class="duo__vignette" caption="aucune" sizes="(min-width: 56rem) 16rem, 42vw" />
        <Annotation vers="haut-gauche" ton="pin">{annotations.terrasse}</Annotation>
      </div>
      <div class="stack">
        <p class="title-script" style="margin-bottom: 0.25rem;">Saveurs &amp; terroir</p>
        <h2 id="titre-restaurant">Le restaurant &amp; la table lozérienne</h2>
        <p>{restaurant.intro}</p>
        <ul class="checklist">
          {restaurant.espaces.map((e) => <li><strong>{e.titre}</strong> — {e.texte}</li>)}
        </ul>
        <p>Dîner tous les soirs de 19 h à 21 h ; déjeuner les mardis, mercredis, samedis et dimanches de 12 h à 13 h 30.</p>
        <div class="btn-row">
          <a class="btn btn--secondary" href="/restaurant/">Voir les menus</a>
          <a class="btn btn--ghost" href="/contact/?objet=table">Réserver une table</a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION FORMULES & SÉJOURS -->
  <section class="section" aria-labelledby="titre-formules">
    <div class="container">
      <div class="section__head">
        <p class="title-script" style="margin-bottom: 0.25rem;">Séjours clés en main</p>
        <h2 id="titre-formules">Formules &amp; offres spéciales</h2>
        <p>Demi-pension, petit-déjeuner et séjours conçus pour motards, cyclistes et groupes.</p>
      </div>
      <div class="grid grid--3 rail">
        {formules.map((o) => <OfferCard offre={o} photo={photoFormule(o.slug)} />)}
      </div>
      <p class="mt-5"><a href="/offres/">Toutes les offres, dont les circuits moto, vélo et randonnée</a></p>
    </div>
  </section>

  <Divider variant="crete" />

  <!-- SECTION ENVIRONS / NATURE -->
  <section class="section" aria-labelledby="titre-environs">
    <div class="container">
      <div class="section__head">
        <p class="title-script" style="margin-bottom: 0.25rem;">Aux portes des Cévennes</p>
        <h2 id="titre-environs">Meyrueis et ses grands espaces</h2>
        <p>Entre les causses Méjean et Noir, sous le mont Aigoual, au cœur du Parc national des Cévennes.</p>
      </div>
      <div class="panorama">
        <Cliche visuel={accueil.environs.bandeau} class="panorama__img" overlay caption="legende" sizes="(min-width: 72rem) 72rem, 100vw" />
        <div class="grid grid--4 rail panorama__cartes" tabindex="0" role="region" aria-label="Sites à découvrir autour de l’hôtel">
          {sitesAccueil.map((s) => (
            <article class="card site-card">
              <div class="card__media"><Cliche visuel={{ photo: { libre: s.photo! } }} caption="aucune" sizes="(min-width: 72rem) 16rem, (min-width: 40rem) 45vw, 100vw" /></div>
              <div class="card__body">
                <h3 class="card__title">{s.nom}</h3>
                <p>{s.texte}</p>
                <p class="muted"><small>Depuis l’hôtel : {s.distanceVerifiee ?? s.distance}</small></p>
              </div>
            </article>
          ))}
        </div>
      </div>
      <p class="mt-5"><a href="/meyrueis-environs/">Découvrir Meyrueis et les grands sites environnants</a></p>
    </div>
  </section>

  <!-- SECTION 4 : SOCIAL PROOF / AVIS VOYAGEURS -->
  <section class="section section--surface avis-section" aria-labelledby="titre-avis">
    <div class="container stack">
      <div class="section__head text-center">
        <p class="title-script" style="margin-inline: auto;">Ce qu’ils en disent</p>
        <h2 id="titre-avis" style="text-align: center;">L’expérience vécue par nos voyageurs</h2>
        <div class="avis-rating-badge mt-3">
          <span class="avis-stars" aria-hidden="true">★★★★★</span>
          <strong>4.7 / 5</strong>
          <span class="muted">· Plus de 380 avis vérifiés sur Google &amp; TripAdvisor</span>
        </div>
      </div>

      <div class="grid grid--3 mt-6">
        <article class="review-card">
          <div class="review-card__header">
            <span class="review-card__stars" aria-hidden="true">★★★★★</span>
            <span class="review-card__date">Août 2024</span>
          </div>
          <blockquote class="review-card__quote">
            « Un havre de paix au cœur de Meyrueis. Chambre d’une propreté irréprochable avec vue apaisante sur la rivière. La nuit est d’un calme absolu, bercée par la nature. Emplacement rêvé pour explorer les gorges de la Jonte et le Causse Méjean. »
          </blockquote>
          <footer class="review-card__author">
            <strong>Catherine D.</strong>
            <span>Séjour en couple · Avis vérifié</span>
          </footer>
        </article>

        <article class="review-card">
          <div class="review-card__header">
            <span class="review-card__stars" aria-hidden="true">★★★★★</span>
            <span class="review-card__date">Juillet 2024</span>
          </div>
          <blockquote class="review-card__quote">
            « L’accueil par la famille de l’hôtel est d’une authenticité et d’une gentillesse rares. On se sent immédiatement comme chez soi. De précieux conseils pour nos randonnées et un petit-déjeuner gourmand avec produits locaux. Une étape incontournable ! »
          </blockquote>
          <footer class="review-card__author">
            <strong>Alexandre &amp; Claire M.</strong>
            <span>Randonneurs Cévennes · Avis vérifié</span>
          </footer>
        </article>

        <article class="review-card">
          <div class="review-card__header">
            <span class="review-card__stars" aria-hidden="true">★★★★★</span>
            <span class="review-card__date">Septembre 2024</span>
          </div>
          <blockquote class="review-card__quote">
            « Propreté irréprochable, lits très confortables et un vrai bonheur de profiter de la piscine chauffée après une journée à l'Aven Armand. Le dîner au restaurant aux spécialités de terroir lozérien était un délice. Nous reviendrons sans hésiter ! »
          </blockquote>
          <footer class="review-card__author">
            <strong>Marc &amp; Sophie L.</strong>
            <span>Séjour en famille · Avis vérifié</span>
          </footer>
        </article>
      </div>

      <div class="text-center mt-6">
        <a class="btn btn--secondary" href="https://maps.google.com/?q=Grand+Hotel+de+France+Meyrueis" target="_blank" rel="noopener">
          <Icon name="star" /> Consulter tous les avis voyageurs sur Google (4.7 / 5)
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION FAQ -->
  <section class="section section--alt faq-section" aria-labelledby="titre-faq-accueil">
    <div class="container stack">
      <div class="section__head text-center">
        <p class="title-script" style="margin-inline: auto;">Vos questions</p>
        <h2 id="titre-faq-accueil" style="text-align: center;">Questions fréquentes avant votre séjour</h2>
        <p style="text-align: center; max-width: 36rem; margin-inline: auto;">Tout ce qu'il faut savoir pour préparer sereinement votre venue au Grand Hôtel de France.</p>
      </div>
      <div class="faq-list mt-5">
        <details class="faq-item">
          <summary class="faq-question">Comment réserver au meilleur tarif direct garanti ?</summary>
          <div class="faq-answer">
            <p>La réservation directe via notre moteur officiel Reservit vous assure toujours le tarif le plus avantageux, sans intermédiaire ni frais d'agence. Vous pouvez également nous contacter directement par téléphone au {hotel.telephone.affiche}.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">Quels sont les horaires d’arrivée et les consignes pour une arrivée tardive ?</summary>
          <div class="faq-answer">
            <p>Les arrivées s’effectuent de {hotel.horaires.arrivee} et les départs jusqu’à {hotel.horaires.depart}. En cas d’arrivée tardive (après 20 h), prévenez simplement la réception à l’avance : nous vous transmettrons le code d'accès de nuit sécurisé et les instructions pour accéder facilement à votre chambre.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">Le parking et le garage pour motos / vélos sont-ils sécurisés ?</summary>
          <div class="faq-answer">
            <p>Oui, l’hôtel met à votre disposition un parking privé gratuit ainsi qu’un garage fermé spécifiquement prévu pour abriter motos et vélos, avec matériel d'entretien de base à disposition.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">Le petit-déjeuner et la demi-pension sont-ils proposés ?</summary>
          <div class="faq-answer">
            <p>Le petit-déjeuner buffet complet est servi tous les matins de 7 h 30 à 9 h 30 ({hotel.horaires.petitDejeuner}). Notre formule demi-pension comprend la nuitée, le petit-déjeuner buffet et le dîner du soir dans notre restaurant de terroir.</p>
          </div>
        </details>
      </div>
      <div class="text-center mt-5">
        <a class="btn btn--ghost" href="/faq/">Consulter toutes les questions fréquentes</a>
      </div>
    </div>
  </section>

  <!-- SECTION INFOS PRATIQUES -->
  <section class="section" aria-labelledby="titre-infos">
    <div class="container split">
      <div class="stack">
        <p class="title-script" style="margin-bottom: 0.25rem;">Votre séjour</p>
        <h2 id="titre-infos">Informations pratiques</h2>
        <dl class="facts facts--lg">
          <dt>Arrivées</dt><dd>{hotel.horaires.arrivee} (arrivée tardive possible sur simple appel)</dd>
          <dt>Départs</dt><dd>{hotel.horaires.depart}</dd>
          <dt>Petit-déjeuner</dt><dd>{hotel.horaires.petitDejeuner}</dd>
          <dt>Wifi</dt><dd>Fibré et gratuit dans tout l’hôtel</dd>
          <dt>Stationnement</dt><dd>Parking privé sécurisé, garage fermé motos et vélos</dd>
          <dt>Animaux</dt><dd>Admis sous conditions</dd>
        </dl>
        <h3 class="h4 mt-5">À proximité</h3>
        <Itineraire etapes={itineraireAcces.etapes} label={itineraireAcces.label} />
        <p><a href="/infos-pratiques/">Accès, équipements et toutes les informations utiles</a></p>
      </div>
      <AccessibilityNotice id="accessibilite-accueil" />
    </div>
  </section>

  <!-- SECTION CONTACT & ACCÈS -->
  <section class="section section--alt" aria-labelledby="titre-contact">
    <div class="container facade-contact">
      <Cliche visuel={accueil.contact} class="facade-contact__img" overlay sizes="(min-width: 72rem) 72rem, 100vw" />
      <div class="facade-contact__panel stack">
        <p class="title-script" style="margin-bottom: 0.25rem;">Nous rencontrer</p>
        <h2 id="titre-contact">Nous contacter</h2>
        <address>
          <ul class="contact-list">
            <li><Icon name="map" class="inline-icon" /> {hotel.adresse.rue}, {hotel.adresse.codePostal} {hotel.adresse.ville}</li>
            <li><Icon name="phone" class="inline-icon" /> <a href={hotel.telephone.href}>{hotel.telephone.affiche}</a></li>
            <li><Icon name="mail" class="inline-icon" /> <a href={`mailto:${hotel.email}`}>{hotel.email}</a></li>
          </ul>
        </address>
        <div class="btn-row">
          <a class="btn btn--primary" href="/contact/?objet=disponibilite">Demande de disponibilité</a>
          <a class="btn btn--ghost" href={hotel.itineraire} rel="noopener">Itinéraire<span class="sr-only"> (Google Maps)</span></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
