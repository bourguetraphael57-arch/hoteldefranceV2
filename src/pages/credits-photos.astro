---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageHero from '../components/PageHero.astro';
import { photos } from '../data/photos';
import { chambres } from '../data/chambres';
import { creditsPage as t, photosOfficiellesAvecUsage } from '../data/visuels';

const officielles = photosOfficiellesAvecUsage(Object.fromEntries(chambres.map((c) => [c.slug, c.nom])));
---
<BaseLayout title="Crédits photos | Grand Hôtel de France" description="Auteurs, licences et sources des photos libres de Meyrueis et de ses environs utilisées sur ce site : photos Wikimedia Commons, redimensionnées pour le web.">
  <Breadcrumbs items={[{ href: '/credits-photos/', label: t.titre }]} />
  <PageHero title={t.titre} lead={t.lead} />
  <div class="container section--tight stack">
    <section class="stack" aria-labelledby="titre-libres">
      <h2 id="titre-libres">{t.libres.titre}</h2>
      <div class="table-wrap" role="region" aria-labelledby="caption-credits" tabindex="0">
        <table class="table table--fiches table--credits">
          <caption id="caption-credits">{t.libres.caption(photos.length)}</caption>
          <thead><tr><th scope="col">Sujet</th><th scope="col">Auteur</th><th scope="col">Licence</th><th scope="col">Source</th></tr></thead>
          <tbody>
            {photos.map((p) => (
              <tr>
                <th scope="row">{p.sujet}</th>
                <td data-label="Auteur">{p.auteur}</td>
                <td data-label="Licence"><a href={p.licenceUrl} rel="license noopener">{p.licence}</a></td>
                <td data-label="Source"><a href={p.source} rel="noopener">Page Wikimedia Commons<span class="sr-only"> : {p.sujet}</span></a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted">{t.libres.note}</p>
    </section>

    <section class="mt-6 stack" aria-labelledby="titre-officielles">
      <h2 id="titre-officielles">{t.officielles.titre}</h2>
      <p>{t.officielles.texte}</p>
      <div class="table-wrap" role="region" aria-labelledby="caption-officielles" tabindex="0">
        <table class="table table--fiches table--credits">
          <caption id="caption-officielles">{t.officielles.caption(officielles.length)}</caption>
          <thead><tr><th scope="col">Photo</th><th scope="col">Usage</th><th scope="col">Droits</th></tr></thead>
          <tbody>
            {officielles.map(({ photo, usage }) => (
              <tr>
                <th scope="row">{photo.alt}{photo.remarque && <><br /><small class="muted">{photo.remarque}</small></>}</th>
                <td data-label="Usage">{usage}</td>
                <td data-label="Droits">{t.officielles.mention}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-6 stack" aria-labelledby="titre-polices">
      <h2 id="titre-polices">{t.polices.titre}</h2>
      <p>{t.polices.texte}</p>
      <ul class="checklist">
        {t.polices.liste.map((f) => (
          <li><strong>{f.nom}</strong> ({f.usage}) — © {f.auteur}, <a href={f.fichier} rel="license">{f.licence}<span class="sr-only"> : texte de la licence de {f.nom}</span></a></li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
