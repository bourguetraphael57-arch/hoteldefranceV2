---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BookingBlock from '../../components/BookingBlock.astro';
import RoomCard from '../../components/RoomCard.astro';
import PhotoPending from '../../components/PhotoPending.astro';
import PhotoOfficielle from '../../components/PhotoOfficielle.astro';
import { photosDe, photoSalleDeBain, creditOfficiel } from '../../data/photos-officielles';
import ConfirmNote from '../../components/ConfirmNote.astro';
import AccessibilityNotice from '../../components/AccessibilityNotice.astro';
import { chambres, equipementsCommuns, vuesChambres, type Chambre } from '../../data/chambres';
import { hotel } from '../../data/hotel';
import { personnes } from '../../lib/format';
import { seo } from '../../data/seo';
import { intros } from '../../data/intros';

export function getStaticPaths() {
  return chambres.map((chambre) => ({ params: { slug: chambre.slug }, props: { chambre } }));
}
interface Props { chambre: Chambre }
const { chambre: c } = Astro.props;
const meta = seo[c.slug as keyof typeof seo];
const autres = chambres.filter((x) => x.slug !== c.slug);
const photosChambre = photosDe(c.slug);
/** Une photo dont la correspondance est incertaine (remarque) ne sert pas de photo principale :
 *  la place reste « photo à venir » et la photo passe en vignette, avec sa remarque. */
const incertaine = photosChambre[0]?.remarque !== undefined;
const principale = incertaine ? undefined : photosChambre[0];
const vignettes = [...(incertaine ? photosChambre : photosChambre.slice(1)), photoSalleDeBain];
---
<BaseLayout title={meta.title} description={meta.description}>
  <Breadcrumbs items={[{ href: '/chambres/', label: 'Chambres' }, { href: `/chambres/${c.slug}/`, label: c.nom }]} />

  <article>
    <div class="container split section--tight">
      <div class="stack">
        <h1 id="titre-page">{c.nom}</h1>
        <dl class="facts facts--lg">
          <dt>Capacité</dt><dd>{c.capacite ? `${personnes(c.capacite)} maximum` : 'Non communiquée'}</dd>
          <dt>Literie</dt><dd>{c.literie ?? 'Non communiquée'}</dd>
          <dt>Surface</dt><dd>{c.surface ?? 'Non communiquée'}</dd>
          <dt>Tarif</dt><dd>Selon les dates, affiché sur le moteur de réservation</dd>
        </dl>
        <p>{intros[c.slug as keyof typeof intros] ?? c.resume}</p>
        <ConfirmNote items={c.aConfirmer} />
        <div class="btn-row">
          <a class="btn btn--primary" href="#reserver">Choisir mes dates</a>
          <a class="btn btn--ghost" href={hotel.telephone.href}>Appeler le <span class="tel-num">{hotel.telephone.affiche}</span></a>
        </div>
      </div>
      <div class="room-gallery">
        {photosChambre.length > 0 ? (
          <>
            {principale
              ? <PhotoOfficielle photo={principale} class="room-gallery__main" legende={false} eager />
              : <PhotoPending label={`${c.nom} (photo de la chambre à prendre)`} ratio="3 / 2" class="media-rounded" />}
            <ul class="room-gallery__thumbs" aria-label={`Autres photos : ${c.nom.toLowerCase()} et salle de bain`}>
              {vignettes.map((p) => (
                <li>
                  <a href={`${p.src}-1600.jpg`} data-full={`${p.src}-1600.webp`} data-alt={p.alt} data-remarque={p.remarque}>
                    <PhotoOfficielle photo={p} legende={false} sizes="(min-width: 64rem) 12rem, 33vw" />
                    <span class="sr-only"> — agrandir</span>
                  </a>
                  {p.remarque && <p class="credit">{p.remarque}</p>}
                </li>
              ))}
            </ul>
            <p class="credit">{creditOfficiel} (photos du site actuel, en attente d’accord) · <a href="/credits-photos/">crédits</a></p>
            <dialog class="lightbox" aria-label={`Visionneuse : photos de la ${c.nom.toLowerCase()}`} data-credit={creditOfficiel}>
              <div class="lightbox__inner">
                <div class="lightbox__bar">
                  <p class="lightbox__count" aria-live="polite"></p>
                  <button type="button" data-close>Fermer</button>
                </div>
                <figure class="lightbox__figure">
                  <img alt="" hidden />
                  <figcaption></figcaption>
                </figure>
                <div class="lightbox__bar">
                  <button type="button" data-prev>← Précédente</button>
                  <button type="button" data-next>Suivante →</button>
                </div>
              </div>
            </dialog>
          </>
        ) : (
          <PhotoPending label={`${c.nom} (photo officielle en attente d’autorisation)`} ratio="4 / 3" class="media-rounded" />
        )}
      </div>
    </div>

    <div class="container section--tight">
      <BookingBlock roomtcode={c.roomtcode} chambre={c.nom} titre={`Réserver la ${c.nom.toLowerCase()}`} />
    </div>

    <div class="container split section">
      <section aria-labelledby="titre-equipements" class="stack">
        <h2 id="titre-equipements">Équipements</h2>
        <ul class="checklist">
          {equipementsCommuns.map((e) => <li>{e}</li>)}
          <li>Ascenseur (étages desservis à confirmer)</li>
        </ul>
        <p class="muted">{vuesChambres}</p>
      </section>
      <section aria-labelledby="titre-conditions" class="stack">
        <h2 id="titre-conditions">Bon à savoir</h2>
        <dl class="facts facts--lg">
          <dt>Arrivée</dt><dd>{hotel.horaires.arrivee}</dd>
          <dt>Départ</dt><dd>{hotel.horaires.depart}</dd>
          <dt>Petit-déjeuner</dt><dd>{hotel.horaires.petitDejeuner}, en supplément</dd>
          <dt>Animaux</dt><dd>Admis sous conditions, à signaler à la réservation</dd>
        </dl>
        <AccessibilityNotice headingLevel="h3" id="accessibilite-chambre" />
      </section>
    </div>
  </article>

  <section class="section section--alt" aria-labelledby="titre-autres">
    <div class="container">
      <h2 id="titre-autres">Les autres chambres</h2>
      <div class="grid grid--3 mt-5">
        {autres.map((x) => <RoomCard chambre={x} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Vignettes de la chambre : visionneuse <dialog> (← →, Échap, balayage). Sans JS, lien vers l'image.
  const root = document.querySelector<HTMLElement>('.room-gallery');
  const dialog = root?.querySelector('dialog');
  const links = [...(root?.querySelectorAll<HTMLAnchorElement>('.room-gallery__thumbs a') ?? [])];
  if (root && dialog && typeof dialog.showModal === 'function' && links.length > 0) {
    const img = dialog.querySelector('img')!;
    const caption = dialog.querySelector('figcaption')!;
    const count = dialog.querySelector('.lightbox__count')!;
    let current = 0;
    let opener: HTMLElement | null = null;
    // Une seule photo : pas de navigation.
    if (links.length === 1) dialog.querySelectorAll<HTMLElement>('[data-prev], [data-next]').forEach((b) => { b.hidden = true; });
    const show = (i: number) => {
      current = (i + links.length) % links.length;
      const a = links[current]!;
      img.hidden = false;
      img.src = a.dataset.full ?? a.href;
      img.alt = a.dataset.alt ?? '';
      caption.textContent = [a.dataset.alt, a.dataset.remarque, dialog.dataset.credit].filter(Boolean).map((t) => t!.replace(/\.$/, '')).join('. ');
      count.textContent = `Photo ${current + 1} sur ${links.length}`;
    };
    links.forEach((a, i) => a.addEventListener('click', (e) => { e.preventDefault(); opener = a; show(i); dialog.showModal(); }));
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    dialog.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === dialog || (!t.closest('.lightbox__figure img, figcaption, button, a') && t.closest('.lightbox__inner'))) dialog.close();
    });
    let x0: number | null = null;
    dialog.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') x0 = e.clientX; });
    dialog.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    });
    dialog.addEventListener('close', () => opener?.focus());
  }
</script>
